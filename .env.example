# ==============================================================================
# FluxFuse Technologies — Environment Configuration Template
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Search Engine Verification Codes
# ------------------------------------------------------------------------------
# Google Search Console: https://search.google.com/search-console
# Choose "HTML tag" verification method, copy only the content string:
# e.g., <meta name="google-site-verification" content="YOUR_GOOGLE_KEY" />
PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Bing Webmaster Tools: https://www.bing.com/webmasters
# Choose "HTML Meta Tag" verification, copy the content string:
PUBLIC_BING_SITE_VERIFICATION=""

# Yandex Webmaster (Optional for international/Eastern Europe search):
PUBLIC_YANDEX_VERIFICATION=""

# ------------------------------------------------------------------------------
# 2. Web Analytics & Event Tracking
# ------------------------------------------------------------------------------
# Google Analytics 4 (GA4) Measurement ID (format: G-XXXXXXXXXX)
# Find in Google Analytics > Admin > Data Streams > Web > Measurement ID
PUBLIC_GA_TRACKING_ID=""

# Google Tag Manager Container ID (format: GTM-XXXXXXX) - Optional if using GA4 directly
PUBLIC_GTM_ID=""
