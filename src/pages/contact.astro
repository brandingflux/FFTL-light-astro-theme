---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'

// - Blocks
import Hero from '../components/blocks/hero/SimpleHeroBasic.astro'
import ContactInfo from '../components/blocks/contact/ContactInfoCards.astro'
import Brand from '../components/blocks/brand/Marquee.astro'
import Faq from '../components/blocks/faq/StickyFaq.astro'
import CTA from '../components/blocks/cta/CTAPrimary.astro'

// Content
// - SEO
const SEO = {
	title: 'Contact FluxFuse Technologies — Partner With Our Team',
	description:
		'Get in touch with FluxFuse Technologies. Inquire about custom software engineering, enterprise AI automation, product partnerships, or technical consulting.',
	keywords: [
		'Contact FluxFuse',
		'Hire AI Engineers',
		'Custom Software Consultation',
		'Workflow Automation Agency',
		'FluxFuse Technologies Contact',
		'Software Engineering Inquiries'
	],
	schemaType: 'ContactPage' as const,
	breadcrumbs: [
		{ name: 'Home', url: '/' },
		{ name: 'Contact', url: '/contact' }
	]
}

// - Hero data
const heroData = {
	title: 'Have a project or problem to solve?',
	subtitle: 'Let’s Connect',
	text: 'Reach out directly to the FluxFuse team. Whether you need a custom automation pipeline, full-stack application development, or want to explore our tools, we are ready to assist.'
}

// - Contact data
const contactData = {
	title: 'Choose support, sales, or partnership requests and let’s talk.'
}

// - Brand data
const brandData = {
	title: 'Trusted tools and collaborative ecosystems'
}

// - FAQ data
const faqData = {
	title: 'Frequently Asked Questions',
	subtitle: 'Everything you need to know'
}

// - CTA data
const ctaData = {
	title: 'Let’s Build the Future Together',
	text: 'Ready to modernize your operations, build intelligent tools, or launch your next product? Partner with the engineering team at FluxFuse.',
	buttonLink: 'mailto:contact@fluxfuse.net',
	buttonText: 'Contact Our Team'
}
---

<Layout
	title={SEO.title}
	description={SEO.description}
	keywords={SEO.keywords}
	schemaType={SEO.schemaType}
	breadcrumbs={SEO.breadcrumbs}
	footer="motion"
>
	<Hero
		title={heroData.title}
		subtitle={heroData.subtitle}
		text={heroData.text}
	/>
	<ContactInfo title={contactData.title} />
	<Brand title={brandData.title} />
	<Faq subtitle={faqData.subtitle} title={faqData.title} />
	<CTA
		title={ctaData.title}
		text={ctaData.text}
		buttonLink={ctaData.buttonLink}
		buttonText={ctaData.buttonText}
	/>
</Layout>
