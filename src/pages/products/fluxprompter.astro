	{/* Section 6: The Comparison Table */}
	<Section classes="py-20! bg-neutral-50 dark:bg-neutral-900/40 border-y border-neutral-200 dark:border-neutral-800">
		<Row style="transparent">
			<Col span="12" style="transparent">
				<div class="text-center max-w-3xl mx-auto mb-14">
					<p class="text-xs font-mono font-bold uppercase tracking-widest text-primary-600 dark:text-primary-400 mb-2">
						Side-by-Side Reality
					</p>
					<h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-neutral-950 dark:text-white">
						The Old Way vs. The FLUXPROMPTER Way
					</h2>
				</div>

				<div class="w-full max-w-4xl mx-auto overflow-x-auto">
					<table class="w-full border-collapse border border-neutral-200 dark:border-neutral-800 text-left bg-white dark:bg-neutral-950 text-sm sm:text-base">
						<thead>
							<tr class="bg-neutral-100 dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800">
								<th class="p-4 font-bold text-neutral-900 dark:text-white">Delivery Experience</th>
								<th class="p-4 font-bold text-neutral-500 dark:text-neutral-400">Old Prompters & Notes</th>
								<th class="p-4 font-bold text-primary-600 dark:text-primary-400">With FLUXPROMPTER</th>
							</tr>
						</thead>
						<tbody>
							{
								comparison.map((item, idx) => (
									<tr class={idx % 2 === 0 ? 'bg-transparent' : 'bg-neutral-50/50 dark:bg-neutral-900/20'}>
										<td class="p-4 font-semibold text-neutral-900 dark:text-white border-t border-neutral-200 dark:border-neutral-800">
											{item.metric}
										</td>
										<td class="p-4 text-neutral-600 dark:text-neutral-400 border-t border-neutral-200 dark:border-neutral-800">
											{item.oldWay}
										</td>
										<td class="p-4 font-medium text-emerald-600 dark:text-emerald-400 border-t border-neutral-200 dark:border-neutral-800">
											<span class="inline-flex items-center gap-1.5">
												<span>✓</span> {item.fluxWay}
											</span>
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</Col>
		</Row>
