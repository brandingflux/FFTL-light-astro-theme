							<Icon name="puzzle-piece" class="size-6" />
							<span>Add FLUXPROMPTER to Chrome — Free</span>
						</a>
					</div>

					<p class="text-xs font-mono text-neutral-400">
						No sign-up required &bull; Installs in two clicks &bull; 100% private and on-device processing
					</p>
				</div>
			</Col>
		</Row>
	</Section>
</Layout>
