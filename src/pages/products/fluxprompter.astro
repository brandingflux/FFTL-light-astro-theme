					</p>

					<div class="flex flex-wrap items-center justify-center gap-4 mb-6">
						<a
							href="https://chromewebstore.google.com"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center px-10 py-5 text-base sm:text-lg font-bold text-white bg-primary-600 hover:bg-primary-500 shadow-2xl hover:shadow-primary-600/40 transition-all gap-3"
