		<Row style="transparent">
			<Col span="12" style="transparent">
				<div class="max-w-3xl mx-auto">
					<p class="text-xs font-mono font-bold uppercase tracking-widest text-primary-400 mb-3">
						Get Started in 10 Seconds
					</p>
					<h2 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight text-white mb-6">
						Ready to Record Flawless Takes on Your Very First Try?
					</h2>
					<p class="text-base sm:text-lg text-neutral-300 leading-relaxed mb-10 max-w-2xl mx-auto">
