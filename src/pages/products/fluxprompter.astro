				audiences.map((aud) => (
					<Col span="3" spanTablet="6" spanMobile="12" style="transparent">
						<div class="p-6 sm:p-8 h-full bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
							<div>
								<div class="size-10 rounded bg-neutral-100 dark:bg-neutral-900 text-primary-600 dark:text-primary-400 border border-neutral-200 dark:border-neutral-800 flex items-center justify-center mb-5">
									<Icon name={aud.icon} class="size-5" />
								</div>
								<h3 class="text-lg font-bold tracking-tight text-neutral-950 dark:text-white mb-2">
									{aud.role}
								</h3>
								<p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
