---
// Features Redirect / Alternate Page
// ------------
// Redirects to /products in astro.config.mjs

import Layout from '../layouts/Layout.astro'
import Hero from '../components/blocks/hero/SimpleHeroPrimary.astro'
import BasicFeatures from '../components/blocks/features/StickyBasicFeatures.astro'
import CTA from '../components/blocks/cta/CTAPrimary.astro'

const SEO = {
	title: 'Features & Capabilities — FluxFuse Technologies',
	description:
		'Explore the technology features, workflow automations, and engineering architecture built by FluxFuse.',
	canonical: 'https://fluxfuse.net/products',
	noindex: true
}

const heroData = {
	title: 'Software Built for Practical Scale',
	subtitle: 'Core Capabilities',
	text: 'Our platforms and tools are designed to help you move faster, eliminate busywork, and achieve more without unnecessary bloat.'
}

const ctaData = {
	title: 'Explore Our Product Portfolio',
	text: 'Discover DeskSync, QuickMark, PromptCraft, and our custom software development capabilities.',
	buttonLink: '/products',
	buttonText: 'View Products'
}
---

<Layout
	title={SEO.title}
	description={SEO.description}
	canonical={SEO.canonical}
	noindex={SEO.noindex}
>
	<Hero title={heroData.title} subtitle={heroData.subtitle} text={heroData.text} />
	<BasicFeatures />
	<CTA
		title={ctaData.title}
		text={ctaData.text}
		buttonLink={ctaData.buttonLink}
		buttonText={ctaData.buttonText}
	/>
</Layout>
