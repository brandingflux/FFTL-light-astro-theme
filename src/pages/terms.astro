---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
import Row from '../components/ui/Row.astro'
import Col from '../components/ui/Col.astro'
// - Blocks
import Hero from '../components/blocks/hero/SimpleHeroNeutral.astro'
import SectionSticky from '../components/blocks/basic/StickySidebarTransparent.astro'
// - UI
import Header from '../components/ui/Header.astro'

// Content
// - SEO
const SEO = {
	title: 'Terms of Service & Privacy Policy — FluxFuse Technologies',
	description:
		'Review the terms of service, acceptable use, and privacy principles governing FluxFuse Technologies applications, services, and digital platforms.',
	keywords: [
		'FluxFuse Terms of Service',
		'Terms and Conditions',
		'FluxFuse Privacy Policy',
		'Acceptable Use Policy',
		'FluxFuse Technologies Legal'
	],
	breadcrumbs: [
		{ name: 'Home', url: '/' },
		{ name: 'Terms of Service', url: '/terms' }
	]
}

// - Hero
const heroData = {
	title: 'Clear, Transparent & Fair Terms of Service',
	subtitle: 'Terms & Conditions',
	text: 'Welcome to FluxFuse Technologies. These Terms and Conditions outline the standards, responsibilities, and guidelines that apply when utilizing our applications, platforms, and client services. Please review them carefully.'
}
---

<Layout
	title={SEO.title}
	description={SEO.description}
	keywords={SEO.keywords}
	breadcrumbs={SEO.breadcrumbs}
>
	<Hero
		title={heroData.title}
		subtitle={heroData.subtitle}
		text={heroData.text}
		textClasses="max-w-xl!"
	/>
	<SectionSticky>
		<Header
			title="About This Agreement"
			subtitle="Introduction"
			headingLevel="h2"
			titleClasses="bg-white dark:bg-neutral-950"
			slot="sidebar"
		/>
		<Row decorationBorder="top bottom" decorationBorderStyle="dashed" style="transparent">
			<Col span="12" style="transparent">
				<div class="text-basic bg-white p-8 dark:bg-neutral-950 [&_h3]:text-xl!">
					<h3>Welcome to FluxFuse</h3>
					<p>
						Welcome to FluxFuse Technologies Limited ("FluxFuse", "we", "us", or "our"). Our mission is to build practical software, AI automation pipelines, and digital solutions that empower productive, high-impact work. By accessing our website, applications, or services, you agree to these Terms and Conditions.
					</p>
					<p>
						Your privacy and satisfaction matter to us. If you have questions or concerns regarding these terms, please contact our team at <a href="mailto:contact@fluxfuse.net" class="text-primary-600 dark:text-primary-400 underline">contact@fluxfuse.net</a>.
					</p>
					<h3>Acceptance of Terms</h3>
					<p>
						By accessing or using our websites, software, browser extensions, or custom development services, you agree to comply with and be bound by these Terms of Service. If you disagree with any portion of these terms, you should not access or use our services.
					</p>
					<p>
						We may update these terms periodically to reflect product updates, regulatory requirements, or operational changes. Any modifications will be posted here with an updated revision date.
					</p>
					<h3>Our Commitment to Reliability & Privacy</h3>
					<p>
						At FluxFuse, we prioritize local-first architecture, rigorous data hygiene, and high system availability. We design tools that respect user autonomy, collect only essential operational data, and employ modern encryption standards across all digital touchpoints.
					</p>
				</div>
			</Col>
		</Row>
	</SectionSticky>
	<SectionSticky>
		<Header
			title="Registration and Use"
			subtitle="User Accounts"
			headingLevel="h2"
			titleClasses="bg-white dark:bg-neutral-950"
			slot="sidebar"
		/>
		<Row decorationBorder="top bottom" decorationBorderStyle="dashed" style="transparent">
			<Col span="12" style="transparent">
				<div class="text-basic bg-white p-8 dark:bg-neutral-950 [&_h3]:text-xl!">
					<h3>Account Registration</h3>
					<p>
						To access certain products, developer APIs, or client portals provided by FluxFuse, you may be required to create an account. You agree to provide accurate, complete, and current information during registration.
					</p>
					<h3>Account Security</h3>
					<p>
						You are responsible for safeguarding your credentials and any API tokens issued to you. You agree to notify FluxFuse immediately at <a href="mailto:support@fluxfuse.net" class="text-primary-600 dark:text-primary-400 underline">support@fluxfuse.net</a> if you detect any unauthorized access or security breach.
					</p>
					<h3>Acceptable Use</h3>
					<p>
						You agree not to use FluxFuse software, automation services, or infrastructure for any unlawful purpose, including unauthorized scraping, reverse engineering proprietary binaries, transmitting malicious code, or violating third-party intellectual property rights.
					</p>
				</div>
			</Col>
		</Row>
	</SectionSticky>
	<SectionSticky>
		<Header
			title="General Restrictions and Liability"
			subtitle="Limitations and Liability"
			headingLevel="h2"
			titleClasses="bg-white dark:bg-neutral-950"
			slot="sidebar"
		/>
		<Row decorationBorder="top bottom" decorationBorderStyle="dashed" style="transparent">
			<Col span="12" style="transparent">
				<div class="text-basic bg-white p-8 dark:bg-neutral-950 [&_h3]:text-xl!">
					<h3>Warranty Disclaimer</h3>
					<p>
						Except as explicitly stated in a signed master services agreement, FluxFuse software and websites are provided on an "as is" and "as available" basis without warranties of any kind, whether express or implied.
					</p>
					<h3>Limitation of Liability</h3>
					<p>
						To the maximum extent permitted by applicable law, FluxFuse Technologies Limited shall not be liable for any indirect, incidental, special, consequential, or punitive damages, or loss of profits or data arising from your use of our platforms.
					</p>
					<h3>Contact Information</h3>
					<p>
						For questions regarding these Terms or legal matters, please contact:
						<br />
						<strong>FluxFuse Technologies Limited</strong>
						<br />
						Email: <a href="mailto:contact@fluxfuse.net" class="text-primary-600 dark:text-primary-400 underline">contact@fluxfuse.net</a>
					</p>
				</div>
			</Col>
		</Row>
	</SectionSticky>
</Layout>
