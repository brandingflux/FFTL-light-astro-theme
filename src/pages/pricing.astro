---
// Pricing Redirect / Alternate Page
// ------------
// Redirects to /services in astro.config.mjs

import Layout from '../layouts/Layout.astro'
import Hero from '../components/blocks/hero/SimpleHeroBasic.astro'
import BasicTable from '../components/blocks/pricing/BasicTable.astro'
import Brand from '../components/blocks/brand/Marquee.astro'
import Faq from '../components/blocks/faq/StickyFaq.astro'
import CTA from '../components/blocks/cta/CTAPrimary.astro'

const SEO = {
	title: 'Pricing & Engagement Models — FluxFuse Technologies',
	description:
		'Predictable sprint pricing and project engagement tiers for FluxFuse software engineering and AI automation.',
	canonical: 'https://fluxfuse.net/services',
	noindex: true
}

const heroData = {
	title: 'Choose the Plan That Fits Your Workflow',
	subtitle: 'Transparent Sprints',
	text: 'Whether you need a targeted automation MVP or an ongoing dedicated engineering pod, we deliver high-velocity sprints with predictable deliverables.'
}

const brandData = {
	title: 'Trusted tools and collaborative ecosystems'
}

const faqData = {
	title: 'Everything You Need to Know',
	subtitle: 'Frequently Asked Questions'
}

const ctaData = {
	title: 'Ready to build together?',
	text: 'Schedule a free architectural consultation with our engineering team to review your workflow and scope out your project.',
	buttonLink: '/contact',
	buttonText: 'Book Architecture Call'
}
---

<Layout
	title={SEO.title}
	description={SEO.description}
	canonical={SEO.canonical}
	noindex={SEO.noindex}
>
	<Hero title={heroData.title} subtitle={heroData.subtitle} text={heroData.text} />
	<BasicTable />
	<Brand title={brandData.title} />
	<Faq subtitle={faqData.subtitle} title={faqData.title} />
	<CTA
		title={ctaData.title}
		text={ctaData.text}
		buttonLink={ctaData.buttonLink}
		buttonText={ctaData.buttonText}
	/>
</Layout>
