---
// FluxFuse Home Page
// ------------
// Description: Multi-product technology company and product studio homepage.
// Structured around the 5 major moments specified in revamp.md.

// Layout
import Layout from '../layouts/Layout.astro'

// Blocks
import Hero from '../components/blocks/hero/CenteredHeroCTA.astro'
import FourPillars from '../components/blocks/features/FourPillars.astro'
import FeaturedProducts from '../components/blocks/features/FeaturedProducts.astro'
import ServicesB2B from '../components/blocks/services/ServicesB2B.astro'
import CompanyStory from '../components/blocks/brand/CompanyStory.astro'

// SEO
const SEO = {
	title: 'FluxFuse — Software for the work that matters',
	description:
		'We build apps, AI tools, automations, and digital solutions for businesses and individuals.'
}

// Hero Data
const heroData = {
	title: 'We build technology that',
	rotatingWords: ['gets work done.', 'makes work easier.', 'solves real problems.', 'powers workflows.'],
	subtitle: 'Software for the work that matters',
	text: 'Apps, AI tools, automations, and digital solutions built by FluxFuse.',
	buttonText: 'Explore what we build',
	buttonLink: '#products',
	secondaryButtonText: 'Work with us',
	secondaryButtonLink: '/contact',
	steps: [
		{
			title: 'Identify Friction',
			description: 'We target manual bottlenecks, fragmented workflows, and time-wasting tasks across operations.',
			colorTheme: 'orange' as const
		},
		{
			title: 'Architect Systems',
			description: 'We blueprint pragmatic digital solutions—from lightweight tools to full-scale cloud platforms.',
			colorTheme: 'blue' as const
		},
		{
			title: 'Build & Engineer',
			description: 'We craft native apps, browser extensions, automations, and scalable SaaS platforms with modern code.',
			colorTheme: 'purple' as const
		},
		{
			title: 'Automate Workflows',
			description: 'We integrate tools, APIs, and background processes to eliminate busywork and human error.',
			colorTheme: 'orange' as const
		},
		{
			title: 'Deploy & Power Growth',
			description: 'We ship durable, battle-tested software designed to solve real problems and scale with your work.',
			colorTheme: 'blue' as const
		}
	]
}
---

<Layout title={SEO.title} description={SEO.description} footer="motion">
	{/* 1. Hero */}
	<Hero
		title={heroData.title}
		rotatingWords={heroData.rotatingWords}
		animationType="handwriting"
		subtitle={heroData.subtitle}
		text={heroData.text}
		buttonLink={heroData.buttonLink}
		buttonText={heroData.buttonText}
		secondaryButtonLink={heroData.secondaryButtonLink}
		secondaryButtonText={heroData.secondaryButtonText}
		steps={heroData.steps}
	/>

	{/* 2. What We Do - Four Pillars */}
	<FourPillars />

	{/* 3. Featured Products - Portfolio */}
	<FeaturedProducts />

	{/* 4. Services - Client Solutions */}
	<ServicesB2B />

	{/* 5. Company Story - The Builder Differentiator */}
	<CompanyStory />
</Layout>
