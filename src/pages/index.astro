// Hero Data
const heroData = {
	title: 'We build technology that',
	rotatingWords: ['gets work done.', 'makes work easier.', 'solves real problems.', 'powers workflows.'],
	subtitle: 'Software for the work that matters',
	text: 'Apps, AI tools, automations, and digital solutions built by FluxFuse.',
	buttonText: 'Explore what we build',
	buttonLink: '#products',
	secondaryButtonText: 'Work with us',
	secondaryButtonLink: '/contact',
	steps: [
		{
			title: 'Identify Friction',
			description: 'We target manual bottlenecks, fragmented workflows, and time-wasting tasks across operations.',
			colorTheme: 'orange' as const
		},
		{
			title: 'Architect Systems',
			description: 'We blueprint pragmatic digital solutions—from lightweight tools to full-scale cloud platforms.',
			colorTheme: 'blue' as const
		},
		{
			title: 'Build & Engineer',
			description: 'We craft native apps, browser extensions, automations, and scalable SaaS platforms with modern code.',
			colorTheme: 'purple' as const
		},
		{
