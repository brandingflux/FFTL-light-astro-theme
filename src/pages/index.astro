---

<Layout
	title={SEO.title}
	description={SEO.description}
	keywords={SEO.keywords}
	softwareApps={SEO.softwareApps}
	services={SEO.services}
	footer="motion"
>
	{/* 1. Hero */}
	<Hero
		title={heroData.title}
		rotatingWords={heroData.rotatingWords}
		animationType="handwriting"
		subtitle={heroData.subtitle}
		text={heroData.text}
		buttonLink={heroData.buttonLink}
		buttonText={heroData.buttonText}
		secondaryButtonLink={heroData.secondaryButtonLink}
		secondaryButtonText={heroData.secondaryButtonText}
		steps={heroData.steps}
	/>

	{/* 2. What We Do - Four Pillars */}
	<FourPillars />

	{/* 3. Featured Products - Portfolio */}
	<FeaturedProducts />

	{/* 4. Services - Client Solutions */}
	<ServicesB2B />

	{/* 5. Company Story - The Builder Differentiator */}
	<CompanyStory />
</Layout>
