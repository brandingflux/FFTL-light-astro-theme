---
// 404 Page
// ------------
// Description: The 404 page is a page that displays when a page is not found.

// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - Blocks
import BasicHeroSplitImageCTA from '../components/blocks/hero/BasicHeroSplitImageCTA.astro'

// Content
// - Images
import image from '../assets/404.webp'

// - SEO
const SEO = {
	title: 'Page Not Found (404) — FluxFuse Technologies',
	description:
		'The page you requested could not be found. Return to the FluxFuse Technologies homepage or explore our software products and services.',
	noindex: true,
	nofollow: true
}

// - Hero data
const heroData = {
	title: 'Oops! Page Not Found',
	subtitle: 'Error 404',
	text: 'The page you’re looking for doesn’t exist, has been removed, or the link has changed. Return to our homepage to explore our software and services.',
	image: image,
	buttonText: 'Back to Homepage',
	buttonLink: '/'
}
---

<Layout
	title={SEO.title}
	description={SEO.description}
	noindex={SEO.noindex}
	nofollow={SEO.nofollow}
>
	<BasicHeroSplitImageCTA
		subtitle={heroData.subtitle}
		title={heroData.title}
		text={heroData.text}
		image={heroData.image}
		buttonText={heroData.buttonText}
		buttonLink={heroData.buttonLink}
	/>
</Layout>
