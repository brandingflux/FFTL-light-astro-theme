---
// Blog Page
// ------------
// Description: The main blog page displaying all articles and insights with CollectionPage structured data.

// Components
// - Layout
import Layout from '../../layouts/Layout.astro'
// - Blocks
import Hero from '../../components/blocks/hero/SimpleHeroBasic.astro'
import PostCards from '../../components/blocks/blog/PostCards.astro'

// - Collection
import { getCollection } from 'astro:content'

export async function getStaticPaths({ paginate }: any) {
	const allPosts = await getCollection('blog', ({ id }) => id)
	return paginate(allPosts, { pageSize: 100 })
}
const { page } = Astro.props as any

// Content
// - SEO
const SEO = {
	title: 'Insights, Engineering & AI Automation Blog — FluxFuse',
	description:
		'Read practical engineering articles, AI workflow automation case studies, and software development insights from the team at FluxFuse Technologies.',
	keywords: [
		'FluxFuse Blog',
		'AI Automation Articles',
		'Software Engineering Insights',
		'Product Studio Blog',
		'Workflow Automation Tutorials',
		'Tech Insights'
	],
	schemaType: 'CollectionPage' as const,
	breadcrumbs: [
		{ name: 'Home', url: '/' },
		{ name: 'Blog', url: '/blog' }
	]
}

// Sort blog posts by publication date (newest first)
const sortedBlogPosts = page.data.sort((a: any, b: any) => {
	return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
})
---

<Layout
	title={SEO.title}
	description={SEO.description}
	keywords={SEO.keywords}
	schemaType={SEO.schemaType}
	breadcrumbs={SEO.breadcrumbs}
	footer="motion"
>
	<Hero
		subtitle="Insights & Engineering"
		title="Perspectives on AI, software, and real work"
		text="Articles, architectural breakthroughs, and actionable breakdowns on building software that gets work done."
	/>
	<PostCards data={sortedBlogPosts} />
</Layout>
