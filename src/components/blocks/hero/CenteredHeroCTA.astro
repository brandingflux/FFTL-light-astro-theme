---
// Centered Hero CTA
// ------------
// Description: A hero section with a title and a subtitle, with a centered image
// Properties:
// - title: The title of the hero section
// - subtitle: The subtitle of the hero section
// - text: The text of the hero section
// - buttonText: The text of the button
// - buttonLink: The link of the button
// - buttonClasses: Additional classes for the button
// - classes: Additional classes for the section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
import Button from '../../ui/Button.astro'
// - UI
import Header from '../../ui/Header.astro'
import RotatingText from '../../ui/RotatingText'
import HandwritingText from '../../ui/handwriting-text'
import HowItWorks, { type Step } from '../../ui/how-it-works'

// - Props
type Props = {
	title?: string
	subtitle?: string
	text?: string
	titleSpan?: string
	rotatingWords?: string[]
	animationType?: 'rotating' | 'handwriting'
	buttonText?: string
	buttonLink?: string
	buttonClasses?: string
	secondaryButtonText?: string
	secondaryButtonLink?: string
	secondaryButtonClasses?: string
	classes?: string
	steps?: Step[]
}
const {
	title = '',
	text = '',
	subtitle = '',
	rotatingWords,
	animationType = 'rotating',
	buttonText = '',
	buttonClasses = 'w-full lg:w-auto',
	buttonLink = '/',
	secondaryButtonText = '',
	secondaryButtonLink = '/',
	secondaryButtonClasses = 'w-full lg:w-auto',
	classes = '',
	steps
} = Astro.props
---

<Section classes={`${classes ? classes : ''}`} spacerTop={true}>
	<Row classes="gap-y-0!">
		<!-- Intro Text -->
		<Col span="12" classes="pt-16 lg:pt-24">
			{rotatingWords ? (
				<Header
					subtitle={subtitle}
					classes="text-center"
					titleWidth="mx-auto max-w-3xl"
				>
					<span slot="title" class:list={['header__title-text', 'mx-auto max-w-3xl']}>
						{title}{' '}
						{animationType === 'handwriting' ? (
							<HandwritingText
								client:load
								words={rotatingWords}
								className="text-primary-500 dark:text-primary-400"
								style={{ color: '#FB5700' }}
								height="1.15em"
							/>
						) : (
							<RotatingText client:load words={rotatingWords} />
						)}
					</span>
				</Header>
			) : (
				<Header
					title={title}
					subtitle={subtitle}
					classes="text-center"
					titleWidth="mx-auto max-w-3xl"
				/>
			)}
			{
				text && (
					<p class="mx-auto mb-0! max-w-2xl pt-6 text-center text-xl leading-9 lg:pt-12">
						{text}
					</p>
				)
			}
		</Col>

		<Col
			span="12"
			classes=" bg-[url('/bgs/dot-gray-light.svg')] bg-size-[18px] bg-fixed dark:bg-[url('/bgs/dot-gray-dark.svg')] "
		>
			<div class="my-10 flex flex-col sm:flex-row items-center justify-center gap-4">
				<Button classes={buttonClasses} link={buttonLink}>{buttonText}</Button>
				{secondaryButtonText && (
					<Button
						style="neutral"
						classes={secondaryButtonClasses || 'w-full lg:w-auto'}
						link={secondaryButtonLink}
					>
						{secondaryButtonText}
					</Button>
				)}
			</div>
			<div class="w-full pb-8">
				<HowItWorks client:load features={steps} className="bg-transparent!" />
			</div>
		</Col>
	</Row>
</Section>
