---
// Contact Info Cards
// ------------
// Description: A contact info cards section with a title
// Properties:
// - title: The title of the contact info cards section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import ActionCard from '../../ui/cards/ActionCard.astro'
import DecorationBorder from '../../ui/DecorationBorder.astro'

// Content
// - Props
type Props = {
	title?: string
}
const { title = '' } = Astro.props
---

<Section>
	<Row decorationBorder="top left " gapY="0" style="transparent">
		<Col
			span="12"
			classes="px-8 py-12 relative bg-[url('/bgs/dot-gray-light.svg')] bg-size-[18px] bg-fixed dark:bg-[url('/bgs/dot-gray-dark.svg')] dark:bg-size-[18px] dark:bg-fixed "
		>
			<h2 class="h5 mb-0! text-center leading-0">{title}</h2>
			<DecorationBorder type="bottom" style="dashed" />
		</Col>
	</Row>
</Section>
<Section>
	<Row decorationBorder="top left right bottom" gapY="0" style="transparent">
		<Col span="4" style="transparent">
			<ActionCard title="Support" link="mailto:support@fluxfuse.net" linkText="Contact Support">
				<p>
					Have questions about DeskSync, PromptCraft, or custom tools? Our technical team is ready to help you resolve any issues promptly.
				</p>
			</ActionCard>
		</Col>
		<Col span="4" style="transparent">
			<ActionCard title="Sales & Projects" link="mailto:sales@fluxfuse.net" linkText="Connect with Sales">
				<p>
					Interested in bespoke AI automation, custom software development, or enterprise licensing? Let’s map out a solution tailored to your goals.
				</p>
			</ActionCard>
		</Col>
		<Col span="4" style="transparent">
			<ActionCard title="General & Partnerships" link="mailto:contact@fluxfuse.net" linkText="Send an Inquiry">
				<p>
					Exploring strategic partnerships, co-building opportunities, or have a unique inquiry? We would love to discuss how we can collaborate.
				</p>
			</ActionCard>
		</Col>
	</Row>
</Section>
