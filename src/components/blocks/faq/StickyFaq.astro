---
// Sticky FAQ
// ------------
// Description: A sticky FAQ section with a title and a subtitle
// Properties:
// - title: The title of the hero section
// - text: The subtitle of the hero section
// - classes: Additional classes to be added to the hero section

// Components
// - Layout
import SectionSticky from '../../blocks/basic/StickySidebar.astro'
// - UI
import Header from '../../ui/Header.astro'
import DecorationBorder from '../../ui/DecorationBorder.astro'

export interface FaqItem {
	question: string
	answer: string
}

type Props = {
	title?: string
	subtitle?: string
	classes?: string
	items?: FaqItem[]
}

const defaultItems: FaqItem[] = [
	{
		question: 'What is FluxFuse Technologies?',
		answer:
			'FluxFuse Technologies Limited (fluxfuse.net) is an independent software development company and multi-product technology studio. We engineer native desktop software (such as Notchgent), productivity tools, AI workflow automations, and custom software systems.'
	},
	{
		question: 'Is FluxFuse related to FlowFuse or Flux?',
		answer:
			'No. FluxFuse (FluxFuse Technologies Limited, fluxfuse.net) is completely independent and unaffiliated with FlowFuse (an industrial Node-RED IoT platform) or Flux / RunOnFlux (a decentralized Web3 cloud network). FluxFuse focuses specifically on developer tools, desktop HUDs, AI automation pipelines, and consumer productivity software.'
	},
	{
		question: 'What software and tools does FluxFuse build?',
		answer:
			'FluxFuse builds native desktop utilities like Notchgent (open-source Dynamic Island HUD for Windows and Antigravity AI coding), DeskSync (local-first digital asset vault), QuickMark (mobile capture), PromptCraft (AI browser copilot), TabShield (memory-saving productivity extension), and FuseFlow (event-driven cloud automation platform).'
	},
	{
		question: 'Is FluxFuse a blog or a software engineering company?',
		answer:
			'FluxFuse Technologies Limited is a software engineering company and product studio. While we publish engineering notes and articles on our site, our core operation is designing, coding, and releasing software products and custom AI automations.'
	},
	{
		question: 'How long does it take to get started with FluxFuse?',
		answer:
			'Most teams are onboarded within days. For our standalone apps like DeskSync or browser extensions like PromptCraft, setup takes minutes. For custom software engineering and AI automation pipelines, we conduct a rapid discovery sprint and deploy working MVPs within 2 to 3 weeks.'
	},
	{
		question: 'Can FluxFuse integrate with our existing stack?',
		answer:
			'Yes. We build integrations across existing CRMs, relational databases, cloud storage, Slack, Notion, and custom internal APIs, ensuring your workflows remain consistent while eliminating manual busywork.'
	}
]

const { title = '', subtitle = '', classes = '', items = defaultItems } = Astro.props
---

<SectionSticky classes={`${classes ? classes : ''}`}>
	<Header
		title={title}
		subtitle={subtitle}
		headingLevel="h2"
		titleClasses="bg-white dark:bg-neutral-950 "
		slot="sidebar"
	/>

	<div class="faq">
		{items.map((item) => (
			<div class="faq__item">
				<h3 class="faq__item__title">{item.question}</h3>
				<p class="faq__item__text">{item.answer}</p>
				<DecorationBorder type="top bottom" style="dashed" />
			</div>
		))}
	</div>
</SectionSticky>

<style>
	@reference '../../../styles/global.css';
	.faq {
		@apply flex flex-col gap-6 lg:gap-8;
	}
	.faq__item {
		@apply relative bg-white p-6 lg:p-8 dark:bg-neutral-950;
	}
	.faq__item__title {
		@apply mb-2 text-2xl leading-8;
	}
	.faq__item__text {
		@apply mb-0 text-xl leading-8;
	}
</style>
