---
// Sticky FAQ
// ------------
// Description: A sticky FAQ section with a title and a subtitle
// Properties:
// - title: The title of the hero section
// - text: The subtitle of the hero section
// - classes: Additional classes to be added to the hero section

// Components
// - Layout
import SectionSticky from '../../blocks/basic/StickySidebar.astro'
// - UI
import Header from '../../ui/Header.astro'
import DecorationBorder from '../../ui/DecorationBorder.astro'

// Content
// - Props
type Props = {
	title?: string
	subtitle?: string
	classes?: string
}
const { title = '', subtitle = '', classes = '' } = Astro.props
---

<SectionSticky classes={`${classes ? classes : ''}`}>
	<Header
		title={title}
		subtitle={subtitle}
		headingLevel="h2"
		titleClasses="bg-white dark:bg-neutral-950 "
		slot="sidebar"
	/>

	<div class="faq">
		<div class="faq__item">
			<h3 class="faq__item__title">How long does it take to get started with FluxFuse?</h3>
			<p class="faq__item__text">
				Most teams are onboarded within days. For our standalone apps like DeskSync or browser extensions like PromptCraft, setup takes minutes. For custom software engineering and AI automation pipelines, we conduct a rapid discovery sprint and deploy working MVPs within 2 to 3 weeks.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
		<div class="faq__item">
			<h3 class="faq__item__title">Do I need technical skills to work with FluxFuse?</h3>
			<p class="faq__item__text">
				Not at all. FluxFuse builds intuitive, self-documenting solutions with clear interfaces anyone on your team can operate. We handle all backend complexity, API integrations, and maintenance, providing full onboarding and training.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
		<div class="faq__item">
			<h3 class="faq__item__title">Can FluxFuse integrate with our existing stack?</h3>
			<p class="faq__item__text">
				Yes. We build integrations across existing CRMs, relational databases, cloud storage, Slack, Notion, and custom internal APIs, ensuring your workflows remain consistent while eliminating manual busywork.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
		<div class="faq__item">
			<h3 class="faq__item__title">How does FluxFuse ensure software security and reliability?</h3>
			<p class="faq__item__text">
				We architect with local-first and zero-bloat principles, employing end-to-end encryption, strict role-based access controls, and self-healing retry queues that protect data integrity and ensure high availability.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
		<div class="faq__item">
			<h3 class="faq__item__title">What happens as our business scales?</h3>
			<p class="faq__item__text">
				FluxFuse software is engineered for scalable cloud growth. Whether supporting a single founder or an enterprise operations department, our architectures dynamically scale with flexible permissions, microservices, and dedicated throughput.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
	</div>
</SectionSticky>

<style>
	@reference '../../../styles/global.css';
	.faq {
		@apply flex flex-col gap-6 lg:gap-8;
	}
	.faq__item {
		@apply relative bg-white p-6 lg:p-8 dark:bg-neutral-950;
	}
	.faq__item__title {
		@apply mb-2 text-2xl leading-8;
	}
	.faq__item__text {
		@apply mb-0 text-xl leading-8;
	}
</style>
