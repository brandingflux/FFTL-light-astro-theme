---
// SEO Component
// ------------
// Description: Enterprise-grade SEO meta tags, OpenGraph, Twitter Cards, and Schema.org structured data.

import { configData } from '../../../../config/config'
import SchemaOrg, {
	type BreadcrumbItem,
	type FaqItem,
	type SoftwareAppItem,
	type ServiceItem
} from './SchemaOrg.astro'

type Props = {
	title?: string
	description?: string
	ogImage?: string
	ogType?: 'website' | 'article'
	canonical?: boolean | string
	noindex?: boolean
	nofollow?: boolean
	keywords?: string[]
	publishDate?: string
	modifiedDate?: string
	author?: string
	schemaType?: 'WebSite' | 'Organization' | 'AboutPage' | 'ContactPage' | 'Article' | 'CollectionPage' | 'SoftwareApplication' | 'Service' | 'FAQPage'
	breadcrumbs?: BreadcrumbItem[]
	faq?: FaqItem[]
	softwareApps?: SoftwareAppItem[]
	services?: ServiceItem[]
	customSchema?: Record<string, any> | Record<string, any>[]
}

const {
	title = configData.siteTitle,
	description = configData.siteDescription,
	ogImage = configData.ogImage,
	ogType = 'website',
	canonical = configData.canonical,
	noindex = configData.noindex,
	nofollow = false,
	keywords = configData.defaultKeywords,
	publishDate,
	modifiedDate,
	author = configData.brandName,
	schemaType,
	breadcrumbs,
	faq,
	softwareApps,
	services,
	customSchema
} = Astro.props

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://fluxfuse.net'

// Compute clean canonical URL without query parameters or hashes
let canonicalUrl: string | null = null
if (canonical !== false) {
	if (typeof canonical === 'string') {
		canonicalUrl = canonical
	} else {
		// Use clean normalized pathname
		const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '') || '/'
		canonicalUrl = new URL(cleanPath, siteUrl).href
	}
}

// Compute absolute OG image
const absoluteOgImage = ogImage.startsWith('http')
	? ogImage
	: `${siteUrl}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`

const imageType = absoluteOgImage.endsWith('.png') ? 'image/png' : 'image/jpeg'
const keywordsString = Array.isArray(keywords) ? keywords.join(', ') : keywords
---

<Fragment>
	{/* Title & Primary Description */}
	<title>{title}</title>
	<meta name="description" content={description} />
	{keywordsString && <meta name="keywords" content={keywordsString} />}
	<meta name="author" content={author} />
	<meta name="publisher" content={siteUrl} />
	<meta name="application-name" content={configData.brandName} />
	<meta name="apple-mobile-web-app-title" content={configData.brandName} />
	<meta name="apple-mobile-web-app-capable" content="yes" />
	<meta name="apple-mobile-web-app-status-bar-style" content="default" />
	<meta name="format-detection" content="telephone=no" />

	{/* Canonical URL (Fixed: Single canonical tag, absolute URL) */}
	{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

	{/* Robots Directives */}
	{
		noindex || nofollow ? (
			<meta
				name="robots"
				content={`${noindex ? 'noindex' : 'index'}, ${nofollow ? 'nofollow' : 'follow'}`}
			/>
			<meta
				name="googlebot"
				content={`${noindex ? 'noindex' : 'index'}, ${nofollow ? 'nofollow' : 'follow'}`}
			/>
		) : (
			<>
				<meta
					name="robots"
					content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
				/>
				<meta
					name="googlebot"
					content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
				/>
				<meta
					name="bingbot"
					content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
				/>
			</>
		)
	}

	{/* Open Graph (Facebook, LinkedIn, Discord, Slack, WhatsApp) */}
	<meta property="og:site_name" content={configData.companyName} />
	<meta property="og:type" content={ogType} />
	<meta property="og:url" content={canonicalUrl || Astro.url.href} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={absoluteOgImage} />
	<meta property="og:image:secure_url" content={absoluteOgImage} />
	<meta property="og:image:type" content={imageType} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content={title} />
	<meta property="og:locale" content="en_US" />

	{/* Article Specific Open Graph */}
	{ogType === 'article' && publishDate && (
		<meta property="article:published_time" content={publishDate} />
	)}
	{ogType === 'article' && modifiedDate && (
		<meta property="article:modified_time" content={modifiedDate} />
	)}
	{ogType === 'article' && author && (
		<meta property="article:author" content={author} />
	)}

	{/* Twitter / X Cards */}
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:site" content={configData.twitterHandle} />
	<meta name="twitter:creator" content={configData.twitterHandle} />
	<meta name="twitter:url" content={canonicalUrl || Astro.url.href} />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={absoluteOgImage} />
	<meta name="twitter:image:alt" content={title} />

	{/* Schema.org Structured Data */}
	<SchemaOrg
		title={title}
		description={description}
		url={canonicalUrl || Astro.url}
		ogImage={absoluteOgImage}
		schemaType={schemaType}
		breadcrumbs={breadcrumbs}
		faq={faq}
		article={
			ogType === 'article' && publishDate
				? {
						headline: title,
						description,
						datePublished: publishDate,
						dateModified: modifiedDate,
						author,
						image: absoluteOgImage
				  }
				: undefined
		}
		softwareApps={softwareApps}
		services={services}
		customSchema={customSchema}
	/>
</Fragment>
