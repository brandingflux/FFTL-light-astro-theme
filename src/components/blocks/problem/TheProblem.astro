---
// The Problem
// ------------
// Description: High-impact problem framing highlighting the 3 primary operational time-wasters.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
import { Icon } from 'astro-icon/components'

// Content
const timeWasters = [
	'Copying information between spreadsheets.',
	'Building the same reports every week.',
	'Formatting documents that already have a template.'
]
---

<Section id="the-problem" classes="py-20! lg:py-32!" decorationBorder="none">
	<Row style="transparent" decorationBorder="none">
		<Col span="12" style="transparent">
			<div class="max-w-4xl mx-auto text-center">
				<p class="text-xs md:text-sm font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400 mb-4">
					Where Teams Lose Time
				</p>
				<h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-neutral-950 dark:text-white mb-12 lg:mb-16 leading-tight">
					Your Team Shouldn't Spend Its Day Doing This.
				</h2>
			</div>

			<!-- 3 Big Examples -->
			<div class="max-w-3xl mx-auto flex flex-col gap-4 md:gap-6">
				{
					timeWasters.map((item) => (
						<div class="flex items-center gap-4 md:gap-6 rounded-2xl border border-neutral-200/80 bg-white/60 p-6 md:p-8 backdrop-blur-xs transition hover:border-neutral-400 dark:border-neutral-800 dark:bg-neutral-950/60 dark:hover:border-neutral-700">
							<div class="flex-shrink-0 size-10 md:size-12 rounded-xl bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center text-neutral-400 dark:text-neutral-500">
								<Icon name="x-mark" class="size-5 md:size-6" />
							</div>
							<p class="text-lg md:text-2xl font-medium text-neutral-800 dark:text-neutral-200 mb-0! leading-snug">
								{item}
							</p>
						</div>
					))
				}
			</div>

			<!-- The Core Punchline -->
			<div class="mt-16 lg:mt-20 text-center">
				<p class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-primary-500 dark:text-primary-400 mb-0!">
					We remove the work around the work.
				</p>
			</div>
		</Col>
	</Row>
</Section>

<style>
	@reference '../../../styles/global.css';
</style>
