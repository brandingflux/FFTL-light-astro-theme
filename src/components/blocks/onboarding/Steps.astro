---
// How It Works Block (powered by MagicText from section2.md)
// -----------------------------------------------------------
// Description: Interactive scroll-reveal presentation of the 4-step workflow.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Header from '../../ui/Header.astro'
import DecorationBorder from '../../ui/DecorationBorder.astro'
import { MagicText } from '../../ui/magic-text'

export interface StepItem {
	number: string
	title: string
	description: string
}

export interface Props {
	data?: {
		subtitle?: string
		title?: string
		magicText?: string
		steps?: StepItem[]
	}
}

const { data: passedData } = Astro.props

const subtitle = passedData?.subtitle ?? 'How it works'
const title = passedData?.title ?? 'A thoughtful flow from idea to action.'
const magicText =
	passedData?.magicText ??
	'We analyze how work moves through your business, uncover repetitive tasks, formatting delays, and manual bottlenecks, and build seamless automations tailored to your existing tools — so your team spends less time on busywork and more time on high-impact growth.'

const steps: StepItem[] = passedData?.steps ?? [
	{
		number: '01',
		title: 'We Analyze',
		description: 'We map how work actually moves through your tools, documents, and spreadsheets.'
	},
	{
		number: '02',
		title: 'Find Bottlenecks',
		description: 'We identify repetitive tasks, delays, and wasted effort slowing your team down.'
	},
	{
		number: '03',
		title: 'We Automate',
		description: 'We build custom, reliable automations tailored specifically to your workflow.'
	},
	{
		number: '04',
		title: 'You Save Time',
		description: 'Your team spends less time on admin work and more time on high-value growth.'
	}
]
---

<Section id="how-it-works" classes="how-it-works-section overflow-visible! scroll-mt-24">
	<Row style="transparent">
		<Col span="12" classes="pt-16 lg:pt-24 pb-4">
			<Header
				title={title}
				headingLevel="h2"
				subtitle={subtitle}
				titleWidth="max-w-3xl"
			/>
		</Col>

		<Col span="12" classes="no-scroll-animation py-8 lg:py-12" style="transparent">
			<div class="relative w-full rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/50 dark:bg-neutral-900/50 p-6 sm:p-10 lg:p-14 shadow-xs backdrop-blur-xs transition-colors">
				<MagicText
					client:visible
					text={magicText}
					className="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-relaxed text-neutral-900 dark:text-white"
					wordClassName="mr-2 sm:mr-3 lg:mr-4 my-1 sm:my-1.5"
				/>
				<DecorationBorder type="all" style="solid" />
			</div>
		</Col>

		<Col span="12" classes="pt-4 pb-16 lg:pb-24" style="transparent">
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
				{
					steps.map((step) => (
						<div class="group relative flex flex-col justify-between rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white dark:bg-neutral-950 p-6 transition-all duration-200 hover:border-neutral-300 dark:hover:border-neutral-700 hover:shadow-xs">
							<div>
								<div class="flex items-center justify-between mb-4">
									<span class="inline-flex items-center justify-center font-mono text-xs font-bold px-2.5 py-1 rounded-md bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 border border-neutral-200/60 dark:border-neutral-800/60">
										STEP {step.number}
									</span>
									<span class="w-2 h-2 rounded-full bg-orange-500/40 dark:bg-orange-400/40 group-hover:bg-orange-500 transition-colors" />
								</div>
								<h3 class="text-lg font-semibold text-neutral-900 dark:text-white mb-2 tracking-tight">
									{step.title}
								</h3>
								<p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
									{step.description}
								</p>
							</div>
							<DecorationBorder type="all" style="solid" />
						</div>
					))
				}
			</div>
		</Col>
	</Row>
</Section>

<style>
	@reference '../../../styles/global.css';

	.how-it-works-section {
		@apply relative overflow-visible;
	}
</style>
