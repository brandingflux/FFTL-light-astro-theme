---
// Blog Layout
// ------------
// Description: An enterprise-grade SEO layout for blog posts with article structured data.
// Properties:
// - frontmatter: The frontmatter of the blog post

// Imports
const { frontmatter } = Astro.props

// Components
// - Layout
import Layout from './Layout.astro'
import Col from '../components/ui/Col.astro'
import Row from '../components/ui/Row.astro'
import Section from '../components/ui/Section.astro'
// - Blocks
import Hero from '../components/blocks/hero/SimpleHeroBasic.astro'
import CTAPrimary from '../components/blocks/cta/CTAPrimary.astro'
// - UI
import DecorationBorder from '../components/ui/DecorationBorder.astro'
import { Image } from 'astro:assets'

// Content
// - Formatting author slug like "john-doe" into "John Doe"
export const formattedAuthorName = (author: string) =>
	author
		? author
				.split('-')
				.map((part) => part.charAt(0).toUpperCase() + part.slice(1))
				.join(' ')
		: 'FluxFuse Team'

const authorName = formattedAuthorName(frontmatter.author)
const formattedDate = new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric'
})

// - CTA data
const CTA = {
	title: 'Launch your next big idea today',
	text: 'Join creators, teams, and startups already turning their ideas into reality with FluxFuse. Explore our tools or partner with our engineering team.',
	buttonText: 'Get in Touch',
	buttonLink: '/contact'
}

const breadcrumbs = [
	{ name: 'Home', url: '/' },
	{ name: 'Blog', url: '/blog' },
	{ name: frontmatter.title, url: Astro.url.pathname }
]
---

<Layout
	title={`${frontmatter.title} | FluxFuse Blog`}
	description={frontmatter.description}
	ogImage={frontmatter.image}
	ogType="article"
	publishDate={frontmatter.pubDate ? new Date(frontmatter.pubDate).toISOString() : undefined}
	author={authorName}
	schemaType="Article"
	breadcrumbs={breadcrumbs}
>
	<Hero
		subtitle={`By ${authorName}, ${formattedDate}`}
		title={frontmatter.title}
		text={frontmatter.description}
		titleWidth="max-w-full"
	/>
	{
		frontmatter.image && (
			<Section>
				<Row>
					<Col span="12">
						<div class="parallax h-96 w-full lg:h-[680px]">
							<Image
								class="h-[calc(100%+50px)] w-full object-cover will-change-transform"
								src={frontmatter.image}
								alt={frontmatter.title}
								loading="lazy"
								decoding="async"
								layout="constrained"
								width={1200}
								height={680}
							/>
						</div>
					</Col>
				</Row>
			</Section>
		)
	}
	<Section>
		<Row style="semitransparent">
			<Col span="12" style="transparent" classes="basic-text flex justify-center items-center">
				<article
					class="relative max-w-5xl bg-white text-xl leading-9 dark:bg-neutral-950 [&_p]:px-8 [&_p]:first:pt-6"
				>
					<slot />
					<DecorationBorder type="top right bottom left" style="solid" />
				</article>
			</Col>
		</Row>
	</Section>
	<CTAPrimary
		title={CTA.title}
		text={CTA.text}
		buttonText={CTA.buttonText}
		buttonLink={CTA.buttonLink}
	/>
</Layout>
