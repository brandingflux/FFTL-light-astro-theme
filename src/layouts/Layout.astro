---
// Layout
// ------------
// Description: The master layout for the page with enterprise SEO head, header, and footer

// Components
import NavigationBar from '../components/ui/NavigationBar.astro'
import Main from '../components/ui/Main.astro'
import Footer from '../components/ui/Footer.astro'
import CinematicFooter from '../components/ui/motion-footer'
import Header from '../components/blocks/head/Header.astro'
import type {
	BreadcrumbItem,
	FaqItem,
	SoftwareAppItem,
	ServiceItem
} from '../components/blocks/head/partials/SchemaOrg.astro'

// Scripts
import Scripts from '../components/scripts/ThemeScripts.astro'
import GoogleTagManager from '../components/scripts/googleTagManagerBody.astro'

// Styles
import '../styles/global.css'

// Data
import { configData } from '../config/config'

// - Swiper
import 'swiper/css'
import 'swiper/css/autoplay'

// Props
type Props = {
	title?: string
	description?: string
	ogImage?: string
	ogType?: 'website' | 'article'
	canonical?: boolean | string
	noindex?: boolean
	nofollow?: boolean
	keywords?: string[]
	publishDate?: string
	modifiedDate?: string
	author?: string
	schemaType?: 'WebSite' | 'Organization' | 'AboutPage' | 'ContactPage' | 'Article' | 'CollectionPage' | 'SoftwareApplication' | 'Service' | 'FAQPage'
	breadcrumbs?: BreadcrumbItem[]
	faq?: FaqItem[]
	softwareApps?: SoftwareAppItem[]
	services?: ServiceItem[]
	customSchema?: Record<string, any> | Record<string, any>[]
	navigation?: 'none' | 'transparent' | 'sticky'
	footer?: 'none' | 'basic' | 'motion'
}

// Page Metadata & Layout Options
const {
	title,
	description,
	ogImage,
	ogType,
	canonical,
	noindex,
	nofollow,
	keywords,
	publishDate,
	modifiedDate,
	author,
	schemaType,
	breadcrumbs,
	faq,
	softwareApps,
	services,
	customSchema,
	navigation = 'sticky',
	footer = 'motion'
} = Astro.props
---

<!doctype html>
<html lang="en" dir="ltr" class="scroll-animation mode-auto">
	<Header
		title={title}
		description={description}
		ogImage={ogImage}
		ogType={ogType}
		canonical={canonical}
		noindex={noindex}
		nofollow={nofollow}
		keywords={keywords}
		publishDate={publishDate}
		modifiedDate={modifiedDate}
		author={author}
		schemaType={schemaType}
		breadcrumbs={breadcrumbs}
		faq={faq}
		softwareApps={softwareApps}
		services={services}
		customSchema={customSchema}
	/>
	<body
		class:list={[
			{ ['mode-' + `${configData.mode}`]: configData.mode },
			{ ['scroll-animation']: configData.scrollAnimations }
		]}
	>
		<GoogleTagManager />
		{navigation !== 'none' && <NavigationBar type={navigation} />}
		<Main>
			<slot />
		</Main>
		{footer === 'motion' && <CinematicFooter client:visible asSection={true} />}
		{footer === 'basic' && <Footer />}
		<Scripts />
	</body>
</html>
